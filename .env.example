ENVIRONMENT=production

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

DATABASE_URL=

REDIS_URL=

# Use ollama for production; mock is reserved for CI/tests.
AI_PROVIDER=ollama

# Must resolve from inside the Compose network/container.
OLLAMA_URL=

OLLAMA_MODEL=

# Santor -> LN-NeU service authentication.
# Santor sends this value as X-LN-NeU-API-Key.
# Keep the same random secret in Santor LN_NEU_API_KEY and LN-NeU SANTOR_API_KEY.
# Production requires at least 32 characters.
SANTOR_API_KEY=
